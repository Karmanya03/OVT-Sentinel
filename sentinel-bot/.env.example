# ── REQUIRED ──
DISCORD_TOKEN=replace_with_discord_bot_token
DATABASE_URL=sqlite:///./data/sentinel.db
AGENT_WS=ws://127.0.0.1:7331
SENTINEL_TOKEN=replace_with_long_random_token

# ── LLM PROVIDERS (configure at least one) ──
# Fallback priority: gemini → groq → openai → sambanova → cerebras → ollama
# If the first provider exhausts/fails, the next one is used seamlessly.

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.1-70B-Instruct

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-70b

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# ── SECURITY ──
ALLOWED_GUILD_IDS=
ALLOWED_USER_IDS=
ALLOWED_CHANNEL_IDS=
REQUIRE_CONFIRM_DESTRUCTIVE=true

# ── FEATURES ──
USE_AGENT_TOOLS=true
USE_WEB_SEARCH=true
USE_LLM_CACHE=true

# ── TUNING ──
MAX_OUTPUT_CHARS=4000
COMMAND_TIMEOUT_SECS=300
LLM_CACHE_TTL_SECS=300
LLM_CACHE_MAX_SIZE=1000
LAZY_AGENT_CONNECT=true
SENTINEL_DATA_DIR=./data
