# Discord
DISCORD_TOKEN=replace_with_discord_bot_token
ALLOWED_GUILD_IDS=123456789,987654321
ALLOWED_USER_IDS=111222333
ALLOWED_CHANNEL_IDS=444555666

# Database
# SQLite (local dev): sqlite:///./sentinel-bot/data/sentinel.db
# PostgreSQL (production): postgresql://<user>:<password>@<host>:5432/<database>
# Koyeb usually gives you a full DATABASE_URL like:
# postgresql://postgres:<password>@<host>:5432/<dbname>
# Use the Postgres URL in Koyeb and keep the SQLite one only for local dev.
DATABASE_URL=sqlite:///./sentinel-bot/data/sentinel.db

# VM Agent Connection
# Set AGENT_WS manually or run agent with --tunnel for auto public URL
AGENT_WS=ws://YOUR_VM_IP:7331
# Optional bootstrap token. Leave blank for pure per-agent / per-tenant setups.
SENTINEL_TOKEN=

# LLM Provider (gemini | groq | sambanova | cerebras | nvidia | openai | ollama)
# Leave blank to auto-select with fallback chain.
# Multiple providers will be tried in order: Cerebras, Groq, Gemini, NVIDIA, OpenAI, SambaNova, Ollama.
LLM_PROVIDER=

# Google Gemini (latest, supports images)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash

# Groq (free tier: 30 req/min Llama 70B, 6000 req/min small models)
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# SambaNova (OpenAI-compatible endpoint, free tier)
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.1-70B-Instruct

# Cerebras (OpenAI-compatible endpoint, free tier)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=Qwen-3-235B-Instruct

# NVIDIA NIM (OpenAI-compatible, free tier: ~40 RPM, no token limits)
# Sign up: https://build.nvidia.com → API key starts with nvapi-
NVIDIA_API_KEY=
NVIDIA_MODEL=mistralai/mistral-large-3-675b-instruct-2512
NVIDIA_MINIMAX_MODEL=minimaxai/minimax-m2.7
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Example environment for local development and deployment
# Fill real values in your deployment environment (Koyeb, Docker env, etc.)

# Discord
DISCORD_TOKEN=replace_with_discord_bot_token
ALLOWED_GUILD_IDS=123456789,987654321
ALLOWED_USER_IDS=111222333
ALLOWED_CHANNEL_IDS=444555666

# Database
# SQLite (local dev): sqlite:///./sentinel-bot/data/sentinel.db
# PostgreSQL (production): postgresql://<user>:<password>@<host>:5432/<database>
# Koyeb usually gives you a full DATABASE_URL like:
# postgresql://postgres:<password>@<host>:5432/<dbname>
DATABASE_URL=sqlite:///./sentinel-bot/data/sentinel.db

# VM Agent Connection
AGENT_WS=ws://127.0.0.1:7331
# Optional bootstrap token. Leave blank for per-agent setups.
SENTINEL_TOKEN=

# LLM Provider (gemini | groq | sambanova | cerebras | openai | ollama)
LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# SambaNova
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.1-70B-Instruct

# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_MODEL=Qwen-3-235B-Instruct

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:70b

# Agent Tools & Security
USE_AGENT_TOOLS=true
USE_WEB_SEARCH=true
MAX_OUTPUT_CHARS=4000
COMMAND_TIMEOUT_SECS=300
REQUIRE_CONFIRM_DESTRUCTIVE=true

# LLM Cache & Performance
USE_LLM_CACHE=true
LLM_CACHE_TTL_SECS=300
LLM_CACHE_MAX_SIZE=1000
LAZY_AGENT_CONNECT=true

# Logging (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Storage
SENTINEL_DATA_DIR=./sentinel-bot/data
